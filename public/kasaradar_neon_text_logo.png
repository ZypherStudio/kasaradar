<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="1000" height="1000">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#0a1a10" stop-opacity="0.8"/>
      <stop offset="60%" stop-color="#020503" stop-opacity="1"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="1"/>
    </radialGradient>

    <!-- Intense Ambient Neon Glow Filter -->
    <filter id="neonBloom" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="35" result="blur1" />
      <feGaussianBlur stdDeviation="70" result="blur2" />
      <feGaussianBlur stdDeviation="12" result="sharpGlow" />
      <feMerge>
        <feMergeNode in="blur2" />
        <feMergeNode in="blur1" />
        <feMergeNode in="sharpGlow" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Deep Ambient Behind Glow Filter -->
    <filter id="deepBackGlow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="55" />
    </filter>

    <!-- Text Neon Gradient (Emerald Green to Cyber Yellow) -->
    <linearGradient id="neonGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00ff88" />
      <stop offset="35%" stop-color="#10b981" />
      <stop offset="70%" stop-color="#eab308" />
      <stop offset="100%" stop-color="#facc15" />
    </linearGradient>

    <!-- Yellow Ambient Glow Behind Text -->
    <radialGradient id="yellowBurst" cx="50%" cy="50%" r="40%">
      <stop offset="0%" stop-color="#facc15" stop-opacity="0.45" />
      <stop offset="50%" stop-color="#10b981" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Solid Pitch Black Background -->
  <rect width="1000" height="1000" fill="#000000" />
  <rect width="1000" height="1000" fill="url(#bgGlow)" />

  <!-- Subtle Circular Tech Frame -->
  <circle cx="500" cy="500" r="460" fill="none" stroke="#10b981" stroke-width="2" stroke-opacity="0.2" />
  <circle cx="500" cy="500" r="440" fill="none" stroke="#facc15" stroke-width="1.5" stroke-dasharray="12 18" stroke-opacity="0.25" />

  <!-- Intense Radiant Yellow-Green Glow Behind Typography -->
  <circle cx="500" cy="490" r="320" fill="url(#yellowBurst)" filter="url(#deepBackGlow)" />

  <!-- Ambient Shadow / Silhouette Glow Text Layer (Deep Blur) -->
  <text 
    x="500" 
    y="515" 
    text-anchor="middle" 
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Montserrat', sans-serif" 
    font-size="118" 
    font-weight="900" 
    letter-spacing="12"
    fill="#facc15" 
    filter="url(#deepBackGlow)"
    opacity="0.9"
  >
    KASARADAR
  </text>

  <!-- Middle Vibrant Green Bloom Layer -->
  <text 
    x="500" 
    y="515" 
    text-anchor="middle" 
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Montserrat', sans-serif" 
    font-size="118" 
    font-weight="900" 
    letter-spacing="12"
    fill="#00ff88" 
    filter="url(#neonBloom)"
    opacity="0.8"
  >
    KASARADAR
  </text>

  <!-- Sharp Main Foreground Text -->
  <text 
    x="500" 
    y="515" 
    text-anchor="middle" 
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Montserrat', sans-serif" 
    font-size="118" 
    font-weight="900" 
    letter-spacing="12"
    fill="url(#neonGradient)"
    stroke="#ffffff"
    stroke-width="1.5"
    stroke-opacity="0.6"
  >
    KASARADAR
  </text>

  <!-- Sleek Cyber Subtitle -->
  <text 
    x="500" 
    y="585" 
    text-anchor="middle" 
    font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" 
    font-size="24" 
    font-weight="700" 
    letter-spacing="22" 
    fill="#facc15"
    opacity="0.95"
  >
    DONANIM &amp; FIRSAT RADARI
  </text>

  <!-- Bottom Mini Accent Line -->
  <line x1="380" y1="620" x2="620" y2="620" stroke="url(#neonGradient)" stroke-width="3" stroke-linecap="round" />
</svg>
